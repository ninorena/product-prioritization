# Copy this file to .env and fill in the values. Never commit .env.

# Your Supabase personal access token (supabase.com/dashboard/account/tokens).
# The scripts use it to apply migrations and to read the project keys.
SUPABASE_ACCESS_TOKEN=

# The project refs: the part of the project URL after /project/.
SUPABASE_TEST_REF=
SUPABASE_PROD_REF=

# The email address of the lead. The lead can make workspaces.
LEAD_EMAIL=
